# Never put the endpoint bearer, Monzo tokens, encryption key, or OAuth client
# secret in this file. Supply secrets through owner-only mounted files.
MONZO_MCP_ENABLE_WRITES=false

# Upstream Monzo token ownership. Unset or "local" is the standalone,
# single-tenant default. The encrypted bundle is writable so refresh-token
# rotation can be persisted; its encryption key remains a separate read-only file.
MONZO_MCP_ACCESS_TOKEN_PROVIDER=local
MONZO_MCP_CREDENTIAL_DIR=/credentials
MONZO_MCP_KEY_FILE=/run/secrets/monzo-mcp.key

# The Docker service exposes only authenticated Streamable HTTP. This file
# contains a separate endpoint bearer, never a Monzo access or refresh token.
MONZO_MCP_ENDPOINT_TOKEN_FILE=/run/secrets/monzo-mcp-endpoint-token
MONZO_MCP_HTTP_HOST=0.0.0.0
MONZO_MCP_HTTP_PORT=8000
MONZO_MCP_HTTP_ALLOWED_HOSTS=monzo-mcp,monzo-mcp:8000
# Browser origins are rejected unless explicitly listed. Non-browser MCP clients
# normally omit Origin.
MONZO_MCP_HTTP_ALLOWED_ORIGINS=

# Broker mode is opt-in for trusted multi-user hosts. Set the provider to
# "broker", then configure the private broker. Local credential paths are ignored.
# MONZO_MCP_ACCESS_TOKEN_PROVIDER=broker
# MONZO_MCP_TOKEN_BROKER_URL=http://api:8000/api/internal/mcp/credential-broker/v1/access-token
# MONZO_MCP_DELEGATION_HEADER_NAME=X-MCP-Credential-Delegation
# MONZO_MCP_TOKEN_BROKER_TIMEOUT_SECONDS=5
